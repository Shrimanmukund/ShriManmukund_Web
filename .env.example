# =============================================================================
# SHRI MANMUKUND HOSPITAL - SUPABASE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your Supabase credentials:
# 1. Project URL and Anon Key from Supabase Dashboard -> Project Settings -> API
# 2. Service Role Key from Supabase Dashboard -> Project Settings -> API -> Project API keys

# Public client credentials (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server-only service role key (NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
